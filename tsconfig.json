{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "~/*": ["./src/*"] }
  },
  "include": [
    "src/routes/**/*.ts",
    "src/routes/**/*.tsx",
    "src/content/**/*.ts",
    "src/components/site/**/*.tsx",
    "src/routeTree.gen.ts",
    "src/vite-env.d.ts",
    "vite.config.ts"
  ]
}
